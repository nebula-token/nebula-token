          "token": {
            "ref": "t0"
          },
          "expect": {
            "ok": false,
            "error": "REUSE_DETECTED"
          }
        }
      ]
    },
    {
      "id": "grace-01-retry-succeeds",
      "title": "Grace retry serves a new token, revokes the unused successor and continues the chain",
      "requirements": [
        "N-30"
      ],
      "config": {
        "reuseGraceSeconds": 60
      },
      "steps": [
        {
          "op": "issue",
          "userId": "u1",
          "bind": "t0"
        },
        {
          "op": "refresh",
          "token": {
            "ref": "t0"
          },
          "bind": "t1",
          "expect": {
            "ok": true,
            "generation": 1
          }
        },
        {
          "op": "advance",
          "seconds": 5
        },
        {
          "op": "refresh",
          "token": {
            "ref": "t0"
          },
          "bind": "t2",
          "expect": {
            "ok": true,
            "generation": 1
          }
        },
        {
          "op": "expectStatusCounts",
          "counts": {
            "active": 1,
            "rotated": 1,
            "revoked": 1
          }
        },
        {
          "op": "refresh",
          "token": {
            "ref": "t1"
          },
          "expect": {
            "ok": false,
            "error": "REVOKED"
          }
        },
        {
          "op": "refresh",
          "token": {
            "ref": "t2"
          },
          "bind": "t3",
          "expect": {
            "ok": true,
            "generation": 2
          }
        }
      ]
    },
    {
      "id": "grace-02-window-not-extendable",

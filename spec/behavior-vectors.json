            "kid": "k1"
          }
        },
        {
          "op": "reconfigure",
          "peppers": [
            "k1",
            "k2"
          ],
          "activeKid": "k2"
        },
        {
          "op": "refresh",
          "token": {
            "ref": "t0"
          },
          "bind": "t1",
          "expect": {
            "ok": true,
            "kid": "k2"
          }
        },
        {
          "op": "refresh",
          "token": {
            "ref": "t1"

{
  "$schema": "./behavior-vectors.schema.json",
  "description": "NEBULA spec version 1 normative behavioral suite (SPECIFICATION.md [N-47], [N-49]). This file is data, not prose: a conforming implementation demonstrates conformance by executing every scenario below against an injected clock, not by re-deriving the cases in its own test framework.",
  "spec_version": 1,
  "counts": {
    "scenarios": 38,
    "unconditional": 37
  },
  "peppers": {
    "k1": "pepper-one-0123456789abcdef0123456789ab",
    "k2": "pepper-two-0123456789abcdef0123456789ab"
  },
  "defaults": {
    "now": 1700000000,
    "absoluteTtlSeconds": 3600,
    "idleTtlSeconds": 600,
    "reuseGraceSeconds": 0,
    "activeKid": "k1",
    "peppers": [
      "k1"
    ]
  },
  "runner": {
    "ops": {
      "issue": "engine.issue(userId, deviceId); bind the result under `bind`",
      "refresh": "engine.refresh(token, deviceId)",
      "revokeToken": "engine.revokeToken(token)",
      "revokeFamilyOf": "engine.revokeFamily(familyId of the binding named by `of`)",
      "revokeUser": "engine.revokeAllForUser(userId)",
      "advance": "clock += seconds",
      "reconfigure": "build a new engine over the SAME store with the given peppers and activeKid",
      "failNextCas": "make the next call to the named store method return false exactly once, then behave normally",
      "expectStatusCounts": "assert the multiset of record statuses currently in the store",
      "expectNoRawSecrets": "assert that no stored field contains any issued token, any verifier part, or any raw device identifier"
    },
    "token": {
      "ref": "name of an earlier binding",
      "literal": "a raw string, used for MALFORMED cases",
      "forge": "derive an invalid token from `ref` (see `forge`)"
    },
    "forge": {
      "verifier": "replace the verifier part with AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA, the canonical base64url of 32 zero bytes: a well-formed, canonical, wrong secret",
      "unknownKid": "replace the kid part with zz, which is never configured",
      "unknownSelector": "replace the selector part with AAAAAAAAAAAAAAAAAAAAAA, which is never stored"
    },
    "deviceIdKind": {
      "lone-surrogate": "construct a string holding a single unpaired surrogate (U+D800). A JSON document cannot carry one, and the ten target runtimes disagree on whether their string type can represent one at all, so it is named here rather than embedded."
    },
    "condition": "A scenario carrying `condition` is executed only where that condition holds for the runtime. A runner MUST execute every unconditional scenario and MUST report, by id, any conditional scenario it skipped ([N-48]).",
    "conditions": {
      "runtime-admits-invalid-unicode-strings": "The runtime's string type can hold an unpaired surrogate. True for JavaScript, Java, C#, Dart and Python; false for Rust and any UTF-8-only string type."
    },
    "expect": {
      "ok": "whether the operation is expected to succeed",
      "error": "expected error code when ok is false",
      "generation": "expected generation of the returned token",
      "kid": "expected kid of the returned token",
      "sameFamilyAs": "the returned familyId must equal that of the named binding",
      "sameExpiresAtAs": "the returned absolute expiry must equal that of the named binding",
      "idleEqualsExpires": "idleExpiresAt must equal expiresAt (the idle clamp hit the ceiling)",
      "hasUserId": "tri-state ([N-39]). true: the failure result MUST carry the userId of the affected record. false: it MUST NOT carry one, because no record was resolved. Absent: not asserted.",
      "hasFamilyId": "tri-state ([N-39]), as hasUserId, for the familyId.",
      "revoked": "expected number of records revoked"
    }
  },
  "scenarios": [
    {
      "id": "rotate-01-basic",
      "title": "Issue then refresh rotates: successor is usable, predecessor is not",
      "requirements": [
        "N-25",
        "N-26",
        "N-34"
      ],
      "steps": [
        {
          "op": "issue",
          "userId": "u1",
          "bind": "t0",
          "expect": {
            "ok": true,
            "generation": 0
          }
        },
        {
          "op": "refresh",
          "token": {
            "ref": "t0"
          },
          "bind": "t1",
          "expect": {
            "ok": true,
            "generation": 1
          }
        },
        {
          "op": "expectStatusCounts",
          "counts": {
            "active": 1,
            "rotated": 1,
            "revoked": 0
          }
        },
        {
          "op": "refresh",
          "token": {
            "ref": "t1"
          },
          "bind": "t2",
          "expect": {
            "ok": true,
            "generation": 2
          }
        }
      ]
    },
    {
      "id": "rotate-02-generation-accounting",
      "title": "Generation increments by exactly one per rotation and familyId is stable",
      "requirements": [
        "N-34"
      ],
      "steps": [
        {
          "op": "issue",
          "userId": "u1",
          "bind": "t0",
          "expect": {
            "ok": true,
            "generation": 0
          }
        },
        {
          "op": "refresh",
          "token": {
            "ref": "t0"
          },
          "bind": "t1",
          "expect": {
            "ok": true,
            "generation": 1,
            "sameFamilyAs": "t0"
          }
        },
        {
          "op": "refresh",
          "token": {
            "ref": "t1"
          },
          "bind": "t2",
          "expect": {
            "ok": true,
            "generation": 2,
            "sameFamilyAs": "t0"
          }
        },
        {
          "op": "refresh",
          "token": {
            "ref": "t2"
          },
          "bind": "t3",
          "expect": {
            "ok": true,
            "generation": 3,
            "sameFamilyAs": "t0"
          }
        },
        {
          "op": "expectStatusCounts",
          "counts": {
            "active": 1,
            "rotated": 3,
            "revoked": 0
          }
        }
      ]
    },
    {
      "id": "reuse-01-replay-revokes-family",
      "title": "Replaying a rotated token revokes the entire family",
      "requirements": [
        "N-30",
        "N-39"
      ],
      "steps": [
        {
          "op": "issue",
          "userId": "u1",
          "bind": "t0"
        },
        {
          "op": "refresh",
          "token": {
            "ref": "t0"
          },
          "bind": "t1",
          "expect": {
            "ok": true
          }
        },
        {
          "op": "refresh",
          "token": {
            "ref": "t0"
          },
          "expect": {
            "ok": false,
            "error": "REUSE_DETECTED",
            "hasUserId": true,
            "hasFamilyId": true
          }
        },
        {
          "op": "expectStatusCounts",
          "counts": {
            "active": 0,
            "rotated": 0,
            "revoked": 2
          }
        },
        {
          "op": "refresh",
          "token": {
            "ref": "t1"
          },
          "expect": {
            "ok": false,
            "error": "REVOKED"
          }
        }
      ]
    },
    {
      "id": "reuse-02-strict-mode-default",
      "title": "With the default grace of 0, any replay burns the family immediately",
      "requirements": [
        "N-30"

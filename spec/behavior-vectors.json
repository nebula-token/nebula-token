    {
      "id": "grace-04-device-mismatch-burns-family",
      "title": "The grace path applies sender binding first; a wrong device revokes the family",
      "requirements": [
        "N-30",
        "N-32"
      ],
      "config": {
        "reuseGraceSeconds": 60
      },
      "steps": [
        {
          "op": "issue",
          "userId": "u1",
          "deviceId": "devA",
          "bind": "t0"

          },
          "expect": {
            "ok": false,
            "error": "MALFORMED",
            "hasUserId": false,
            "hasFamilyId": false
          }
        },
        {
          "op": "refresh",
          "token": {
            "literal": "nbl.k1.AAECAwQFBgcICQoLDA0ODw.AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh9"
          },
          "expect": {
            "ok": false,
            "error": "MALFORMED",
            "hasUserId": false,
            "hasFamilyId": false
          }
        },
        {
          "op": "refresh",
          "token": {
            "literal": "nbl.k1.AAECAwQFBgcICQoLDA0ODw.AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8="
          },
          "expect": {
            "ok": false,
            "error": "MALFORMED",
            "hasUserId": false,
            "hasFamilyId": false
          }
        },
        {
          "op": "revokeToken",

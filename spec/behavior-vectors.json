    {
      "id": "proof-01-verifier-mismatch",
      "title": "A canonical but wrong verifier fails the proof of possession without revoking anything",
      "requirements": [
        "N-26",
        "N-28",
        "N-31",
        "N-39"
      ],
      "steps": [
        {
          "op": "issue",
          "userId": "u1",
          "bind": "t0"
        },
        {
          "op": "refresh",
          "token": {
            "ref": "t0",
            "forge": "verifier"
          },
          "expect": {
            "ok": false,
            "error": "VERIFIER_MISMATCH",
            "hasUserId": true,
            "hasFamilyId": true
          }
        },
        {
          "op": "expectStatusCounts",
          "counts": {
            "active": 1,
            "rotated": 0,
            "revoked": 0
          }
        },
        {
          "op": "refresh",
          "token": {
            "ref": "t0"

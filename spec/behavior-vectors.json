    {
      "id": "revoke-03-family-and-user",
      "title": "Administrative revocation by identifier revokes the right records and is idempotent",
      "requirements": [
        "N-19",
        "N-37"
      ],
      "steps": [
        {
          "op": "issue",
          "userId": "u1",
          "bind": "a0"
        },
        {
          "op": "issue",
          "userId": "u1",
          "bind": "b0"
        },
        {
          "op": "issue",
          "userId": "u2",
          "bind": "c0"
        },
        {
          "op": "revokeFamilyOf",
          "of": "a0",
          "expect": {
            "revoked": 1
          }
        },
        {
          "op": "revokeFamilyOf",
          "of": "a0",
          "expect": {
            "revoked": 0
          }
        },
        {
          "op": "expectStatusCounts",
          "counts": {
            "active": 2,
            "rotated": 0,
            "revoked": 1
          }
        },
        {
          "op": "revokeUser",
          "userId": "u1",
          "expect": {
            "revoked": 1
          }
        },
        {
          "op": "expectStatusCounts",
          "counts": {
            "active": 1,
            "rotated": 0,
            "revoked": 2
          }
        },
        {
          "op": "refresh",
          "token": {
            "ref": "c0"
          },
          "expect": {
            "ok": true
          }
        }
      ]
    },
    {
      "id": "parse-01-malformed-never-throws",

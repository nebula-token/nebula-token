            "ok": true
          }
        },
        {
          "op": "advance",
          "seconds": 200
        },
        {
          "op": "refresh",
          "token": {
            "ref": "t0"
          },
          "expect": {
            "ok": false,
            "error": "REVOKED"
          }
        }
      ]
